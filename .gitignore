# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------- 用户数据
# 这些文件包含登录凭证、完成记录与课程缓存，绝不入库
data/
sites.yaml
*.bak
*.db
*_session.json
*_courses.json

# ---------------------------------------------------------------- 打包产物
# 注意：HomeworkTasks.spec 是**发布配方，必须入库**（README 的打包步骤要用它），
# 所以这里不能忽略 *.spec —— 早期版本忽略它，导致 clone 后按 README 打包必然失败。
build/
dist/

# ---------------------------------------------------------------- 编辑器与日志
.vscode/
.idea/
*.swp
.DS_Store
*.log

# ---------------------------------------------------------------- 字体
# 界面改用**系统字体**（见 web/fonts.css），仓库不再分发 .ttf：
# 原先随仓库带的 Times New Roman / 楷体_GB2312 都是商业字体，
# 放进公开仓库等于再分发（实测前两个与 Windows 自带的 times.ttf 逐字节相同）。
# 如果你想让**本地打包**自带字体，把 .ttf 放进 web/fonts/ —— 这条规则挡住它
# 不进仓库，但 PyInstaller 仍会把它收进安装包。
web/fonts/

# ---------------------------------------------------------------- 本地脚本
# 会读取 sites.yaml 的临时侦察脚本（这些目录在工作区里、不在本仓库内，
# 规则留着是为了防止将来误建到仓库里）
recon/
recon-sandbox*/
